# GeoStream Backend Configuration
# Copy this file to .env and fill in your values.

# Server
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://postgres:YOUR_PASSWORD_HERE@localhost:5432/geostream?sslmode=disable

# JWT Authentication
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Worker Pool
WORKER_COUNT=5
QUEUE_SIZE=100

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# AWS S3 (optional — leave S3_BUCKET empty for local-only video storage)
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Microservice URLs (feature-flagged: leave empty to use fallback) ──

# FastAPI Renderer (empty = use Python subprocess, original behavior)
RENDERER_URL=

# RabbitMQ (empty = use Go in-memory channel, original behavior)
RABBITMQ_URL=

# Redis (empty = use disk-only cache, original behavior)
REDIS_URL=
